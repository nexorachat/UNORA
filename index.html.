<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#07091b">
  <title>UNORA — Tu mundo. Tu gente.</title>
  <link rel="stylesheet" href="./styles.css">
  <script src="./config.js"></script>
</head>
<body>
  <header class="topbar">
    <a class="brand" href="./index.html">
      <span class="brand-logo">U</span>
      <span>UNORA</span>
    </a>
    <span class="tagline">Tu mundo. Tu gente.</span>
  </header>

  <main class="hero">
    <div class="preview preview-left">
      <img src="https://images.unsplash.com/photo-1473116763249-2faaef81ccda?w=600&auto=format&fit=crop" alt="Paisaje compartido">
      <p>Momentos que nos unen 💜</p>
    </div>

    <div class="preview preview-right">
      <img src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?w=600&auto=format&fit=crop" alt="Descubre nuevos lugares">
      <p>Descubre el mundo ✦</p>
    </div>

    <section class="hero-content">
      <div class="hero-symbol">U</div>
      <h1>UNORA</h1>
      <h2>Descubre personas.<br>Vive momentos.<br><span>En un solo lugar.</span></h2>
      <p class="description">
        La red social donde el mundo se encuentra,
        comparte y se inspira.
      </p>

      <div class="actions">
        <button id="create-account" class="button primary">Crear cuenta <span>→</span></button>
        <button id="login" class="button secondary">Iniciar sesión</button>
      </div>
      <p id="message" class="message" role="status"></p>
    </section>
  </main>

  <footer>
    <span>UNORA</span>
    <span>Tu mundo. Tu gente.</span>
  </footer>

  <script>
    const message = document.getElementById("message");

    document.getElementById("create-account").addEventListener("click", () => {
      message.textContent = "El registro se activará al conectar Supabase.";
    });

    document.getElementById("login").addEventListener("click", () => {
      message.textContent = "El inicio de sesión se activará al conectar Supabase.";
    });
  </script>
</body>
</html>
